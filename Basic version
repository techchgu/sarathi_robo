// --- WiFi & Bluetooth Settings ---
const char* ssid = "SARATHI_MISSION_CONTROL";
const char* password = "shivamkumar";
WebServer server(80);
BluetoothSerial SerialBT; 

// --- OLED Display ---
Adafruit_SSD1306 display(128, 64, &Wire, -1);

// --- Servo Motor ---
Servo radarServo;

// --- पिन डेफिनिशन ---
#define TRIG 5
#define ECHO 18
#define BUZZER 25
#define LED 26       
#define MQ2 34       
#define IR_FLOOR 35  
#define LDR1 32      
#define LDR2 33      
#define IN1 12       
#define IN2 13
#define IN3 14
#define IN4 27
#define SERVO_PIN 19 

// --- Variables ---
int mode = 1; // 1: AUTO MODE, 0: MANUAL MODE, 2: ECO MODE
int gasLevel = 0;
int lastGasLevel = 0; // प्रेडिक्टिव एनालिसिस के लिए
String robotStatus = "AUTO MODE"; 
unsigned long lastUpdate = 0;
long globalDist = 0;

// Failsafe Flags 
bool ultrasonicHealthy = true;
bool gasSensorHealthy = true;

// एंटी-कॉर्नर वेरिएबल
int turnCounter = 0; 

// --- Speed Control constants ---
const int MAX_SPEED = 255;  
const int MIN_SPEED = 140;  
const int TURN_SPEED = 160; 
int currentSpeed = MAX_SPEED;

